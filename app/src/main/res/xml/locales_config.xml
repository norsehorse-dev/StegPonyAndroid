<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages StegPony ships, one per values folder. Android 13 and later
  list them under the system's app-language settings. Keep in step with
  SupportedLanguage (i18n/Language.kt).
-->
<locale-config
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:defaultLocale="en">
    <locale android:name="en" />
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="pt-BR" />
    <locale android:name="ru" />
    <locale android:name="zh-Hans" />
</locale-config>
