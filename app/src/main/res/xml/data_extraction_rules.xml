<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or carried to a new phone. allowBackup="false" stops
  cloud backup but not device-to-device transfer on Android 12+, and the
  keyring file is useless without its Keystore key, which never moves.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
