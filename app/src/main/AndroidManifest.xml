<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Nothing leaves the device. Removed explicitly so no library can bring
      network access back in through manifest merging.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!--
      Hardware keys: OpenPGP cards over NFC, and over USB. Neither is
      required, so the app installs on phones with neither; the hardware-key
      buttons are hidden there. USB access is granted per device at run time,
      so there is no permission for it, and no USB attach filter: plugging a
      key in should not launch StegPony.
    -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- The camera is asked for only when the QR scanner opens. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.StegPony">

        <!--
          The activity itself has no intent filters. The launcher entry is on
          the activity-alias entries below, one per launcher disguise; exactly
          one is enabled at a time (ui/settings/Disguise.kt), and the disabled
          ones start disabled here. Never a real app's name or icon.

          Only the undisguised alias takes shares and open-with. Android's
          share sheet shows the app's real name next to an alias's label
          ("StegPony Photo Tools"), so a disguised StegPony stays out of share
          sheets altogether.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share an image in, or open one with it: goes to Reveal. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
            </intent-filter>
            <!-- Share a key in: age1 text, or an OpenPGP key file (PGPony shares application/pgp-keys). Goes to Keys. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pgp-keys" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pgp-keys" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPhotoTools"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_photo_tools"
            android:label="@string/disguise_photo_tools"
            android:roundIcon="@mipmap/ic_disguise_photo_tools"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNotes"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_notes"
            android:label="@string/disguise_notes"
            android:roundIcon="@mipmap/ic_disguise_notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherUtilities"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_utilities"
            android:label="@string/disguise_utilities"
            android:roundIcon="@mipmap/ic_disguise_utilities"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Share-out hands other apps the exact bytes the core wrote. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
